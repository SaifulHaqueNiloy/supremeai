# ── Wave 4 feature flags (প্রতিটি ডিফল্ট-অফ/ডিফল্ট-অপরিবর্তিত — আচরণ-নিরপেক্ষ) ──
# M09 P-A: governed agent tool execution loop (default: off)
SUPREMEAI_AGENT_TOOLS=false
# M06 P-A: universal canonical-run observation on dispatch paths (default: off)
SUPREMEAI_RUN_FABRIC_UNIVERSAL=false
# M01 P-A: memory consolidation kill-switch (default: on; false = legacy blind INSERT)
SUPREMEAI_MEMORY_DEDUP=true
# M01 P-A: consolidation cosine threshold (0,1]; default 0.92
SUPREMEAI_MEMORY_DEDUP_THRESHOLD=0.92
# M19 P-D: Bengali chars-per-token ratio for token estimation; default 2.0
BENGALI_CHARS_PER_TOKEN=2.0
