# SupremeAI — Zero-Cost Infrastructure Configuration
# ================================================
# Zero-cost infrastructure modules using free-tier services

# Redis Configuration (Upstash Free Tier)
REDIS_URL=wss://default:.upstash.io
REDIS_CACHE_TTL=1800  # 30 minutes

# Rate Limiting (Upstash Redis)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Email (Resend Free Tier - 100 emails/day)
RESEND_API_KEY=
RESEND_FROM=supremeai@noreply.com

# Discord Webhooks (Free)
DISCORD_ALERT_WEBHOOK=
DISCORD_LOG_WEBHOOK=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,video/mp4,video/webm

# Caching
CACHE_PROVIDER=upstash
CACHE_FALLBACK_MEMORY=true

# Database (Firebase/Firestore free tier)
FIRESTORE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=localhost:8080

# Task Queue (Cloudflare Workers or Upstash)
TASK_QUEUE_PROVIDER=upstash
TASK_QUEUE_CONCURRENCY=5
