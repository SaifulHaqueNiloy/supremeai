{
  "name": "supremeai-studio-client",
  "description": "SupremeAI Studio Client - Multi-cloud AI orchestration platform web interface",
  "author": "SupremeAI Team",
  "repository": "https://github.com/paykaribazaronline/supremeai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "cross-env VITE_PORTAL_TYPE=admin vite",
    "dev:user": "cross-env VITE_PORTAL_TYPE=user vite",
    "build": "pnpm build:admin && pnpm build:user",
    "build:admin": "cross-env NODE_OPTIONS=--max-old-space-size=4096 VITE_PORTAL_TYPE=admin vite build --mode admin",
    "build:user": "cross-env NODE_OPTIONS=--max-old-space-size=4096 VITE_PORTAL_TYPE=user vite build && node -e \"const fs=require('fs'); if(fs.existsSync('dist-user')) fs.cpSync('dist-user', 'dist', {recursive: true});\"",
    "build:report": "vite build --mode production --reporter=json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecheck:strict": "tsc --noEmit --strict --noImplicitAny",
    "lint:strict": "eslint src/ --ext .ts,.tsx --max-warnings=0",
    "quality": "run-s typecheck:strict lint:strict test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "@supremeai/core-infrastructure": "workspace:*",
    "@supremeai/design-tokens": "workspace:^",
    "@supremeai/shared-services": "workspace:^",
    "@supremeai/shared-types": "workspace:^",
    "@supremeai/ui-components": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@upstash/redis": "^1.38.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xyflow/react": "12.11.2",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "file-saver": "^2.0.5",
    "firebase": "^12.18.0",
    "framer-motion": "^12.43.0",
    "i18next": "^23.16.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.34.0",
    "monaco-editor": "0.55.1",
    "p-queue": "^9.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.7.4",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^6.30.6",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "xterm": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/file-saver": "^2.0.7",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-visitor-keys": "^5.0.1",
    "globals": "^17.11.0",
    "jsdom": "^24.1.3",
    "knip": "^5.88.1",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}