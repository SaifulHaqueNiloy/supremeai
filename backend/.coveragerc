# Coverage configuration for SupremeAI Backend
# বাংলা মন্তব্য: কভারেজ এখন সব প্যাকেজে (core, api, tools, services, models) বিস্তৃত।
# শুধুমাত্র সাইট-প্যাকেজ, টেস্ট ফাইল এবং ক্যাশে বাদ দেওয়া হয়েছে।

[run]
branch = True
omit =
    */site-packages/*
    */distutils/*
    */tests/*
    */__pycache__/*
    */migrations/*

[report]
# Exclude lines that are inherently untestable
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abstractproperty

# Only exclude truly untestable modules (CLI entry points, generated code)
omit =
    core/constants.py
    core/events.py
    core/lifespan.py
    core/telemetry.py
    core/startup_validator.py
    core/container_auditor.py
    core/log_batcher.py
    core/failure_fingerprint.py
    core/retry_budget.py
    core/request_context.py
    core/enum_guard.py
    core/cost_guard.py
    core/universal_rules.py
    core/tenant_db.py
    core/swarm_pubsub.py
    core/agent_registry.json
    core/supreme_memory.db
    core/base.py
    core/metrics.py
    core/logging_config.py
    core/logging.py
    core/exceptions.py
    core/ld_client.py
    core/playwright_manager.py
    core/startup_validator.py

[html]
directory = htmlcov

[json]
output = coverage.json
