ENABLE_ADAPTIVE_ROUTING=true

# --- M13: Security Middleware (zero-hardcode + tenant fail-mode) ---
# Tier-ভিত্তিক API রেট-সীমা (আগে rate_limiter.py-তে ইন-কোড ছিল)
RATE_LIMIT_TIER_FREE=60
RATE_LIMIT_TIER_PRO=600
RATE_LIMIT_TIER_PREMIUM=1200
RATE_LIMIT_TIER_ENTERPRISE=6000
RATE_LIMIT_TIER_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_WARN_RATIO=0.8
# টেন্যান্ট রেট-সীমা (আগে tenant_rate_limiter.py-তে স্থির 100/60)
TENANT_RATE_LIMIT_MAX_HITS=100
TENANT_RATE_LIMIT_WINDOW_SECONDS=60
# Redis-বিভ্রাটে fail-মোড: open (ডিফল্ট, loud) | fallback (বাউন্ডেড ইন-মেমরি) | closed (429)
TENANT_RATE_LIMIT_FAIL_MODE=open
# OTP-pending Redis TTL (আগে anti_hacking.py-তে স্থির 300)
SECURITY_OTP_PENDING_TTL=300

# --- M07 P-E/P-F: Context Engine (single estimator + config + kill-switch) ---
# কিল-সুইচ: off = raw-prompt passthrough (budget assembly বন্ধ); on/অনুপস্থিত = চালু;
# অজানা মান fail-closed (বন্ধ)।
SUPREMEAI_CONTEXT_ENGINE=on
# ডিফল্ট input budget tokens (provider-অজানা কলে; provider জানা থাকলে vendor-সত্য রেজিস্ট্রি)
CONTEXT_ENGINE_DEFAULT_INPUT_BUDGET=3000
# Per-section budget caps (0 < cap ≤ 1; ডিফল্ট = ইঞ্জিনের লিগ্যাসি মান)
CONTEXT_ENGINE_SYSTEM_CAP=0.25
CONTEXT_ENGINE_MEMORY_CAP=0.40
CONTEXT_ENGINE_KNOWLEDGE_CAP=0.60
CONTEXT_ENGINE_HISTORY_CAP=0.75

AUTO_TEST_MAX_TOKENS=8192
LATENCY_NORMALIZATION_MS=2000
LATENCY_WINDOW_SIZE=50
MIN_PROVIDER_WEIGHT=0.05

