{
  "name": "supremeai-mcp-control-plane",
  "version": "1.0.0",
  "description": "SupremeAI Unified MCP Control Tower — connects all services into a single AI-accessible interface",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run test:health-history && tsx test_policy.ts && tsx test_registry.ts && tsx test_events.ts && tsx test_summary.ts && tsx test_resource_list.ts",
    "test:smoke": "tsx test_adapters.ts",
    "test:smoke:report": "tsx scripts/smoke-report.ts",
    "test:service-circles": "tsx test_service_circles.ts",
    "test:timestamps": "tsx test_timestamps.ts",
    "test:health-history": "tsx test_health_history.ts"
  },
  "keywords": [
    "mcp",
    "supremeai",
    "control-tower"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@upstash/redis": "^1.38.3",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
