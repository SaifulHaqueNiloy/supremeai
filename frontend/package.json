{
  "name": "supremeai-studio-client",
  "description": "SupremeAI Studio Client - Multi-cloud AI orchestration platform web interface",
  "author": "SupremeAI Team",
  "repository": "https://github.com/paykaribazaronline/supremeai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "dev:admin": "cross-env VITE_PORTAL_TYPE=admin vite",
    "dev:user": "cross-env VITE_PORTAL_TYPE=user vite",
    "build": "pnpm build:admin && pnpm build:user",
    "build:admin": "cross-env VITE_PORTAL_TYPE=admin vite build",
    "build:user": "cross-env VITE_PORTAL_TYPE=user vite build && node -e \"const fs=require('fs'); if(fs.existsSync('dist-user')) fs.cpSync('dist-user', 'dist', {recursive: true});\"",
    "build:report": "vite build --mode production --reporter=json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none pnpm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "cross-env ELECTRON=true pnpm run build && electron-builder",
    "electron:build:win": "cross-env ELECTRON=true pnpm run build && electron-builder --win",
    "electron:build:mac": "cross-env ELECTRON=true pnpm run build && electron-builder --mac",
    "electron:build:linux": "cross-env ELECTRON=true pnpm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@supremeai/design-tokens": "workspace:^",
    "@supremeai/ui-components": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "cross-env": "^10.1.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.42.0",
    "i18next": "^23.4.0",
    "lucide-react": "^1.21.0",
    "p-queue": "^9.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^15.4.1",
    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "^6.4.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "xterm": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.1",
    "electron": "^41.8.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.0",
    "eslint-visitor-keys": "^5.0.1",
    "globals": "^17.5.0",
    "jsdom": "^24.0.0",
    "storybook": "^8.6.18",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.supremeai.studio",
    "productName": "SupremeAI Studio",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-admin/**/*",
      "node_modules/**/*",
      "package.json",
      "preload.cjs",
      "main.js"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SupremeAI Studio"
    },
    "portable": {
      "artifactName": "SupremeAI-Studio-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 430,
          "y": 220
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "desktop": {
        "Name": "SupremeAI Studio",
        "Comment": "Multi-cloud AI orchestration platform",
        "Exec": "SupremeAI Studio",
        "Icon": "SupremeAI Studio",
        "Type": "Application",
        "Categories": "Development;IDE;"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "paykaribazaronline",
      "repo": "supremeai"
    }
  }
}
