# SupremeAI 2.0 — Environment Variables Template
# Copy this file to .env and fill in your values.
# For production, use the Render dashboard or Infisical vault instead.

# ── Core ──────────────────────────────────────────────────────────────
ENV=local
PORT=8080
HOST=0.0.0.0
SERVICE_ROLE=user  # "user" or "admin"

# ── CORS Origins (comma-separated or JSON array) ───────────────────────
# Production: set these to your actual deployment URLs. Never use "*" in production.
CORS_ORIGINS=["https://supremeai-studio-client.onrender.com","https://supremeai-studio-client-qb34.onrender.com","https://tiny-stroopwafel-2d981c.netlify.app","https://supremeai-lac.vercel.app","https://supremeai-a.web.app","https://supremeai-admin.web.app"]
USER_CORS_ORIGINS=["https://supremeai-studio-client.onrender.com","https://supremeai-studio-client-qb34.onrender.com","https://tiny-stroopwafel-2d981c.netlify.app","https://supremeai-lac.vercel.app","https://supremeai-studio.vercel.app"]
ADMIN_CORS_ORIGINS=["https://supremeai-admin.web.app"]

# ── Allowed Hosts (comma-separated) ────────────────────────────────────
ALLOWED_HOSTS=supremeai-backend.onrender.com,supremeai-backend-docker.onrender.com

# ── Secrets (REQUIRED in production) ───────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SUPREMEAI_JWT_SECRET=
JWT_SECRET=
SUPREMEAI_ADMIN_PASSWORD_HASH=
SUPREMEAI_ENCRYPTION_KEY=
SUPREMEAI_API_TOKEN=
SUPREMEAI_DOCS_USERNAME=admin
SUPREMEAI_DOCS_PASSWORD=

# ── Backend Configuration ──────────────────────────────────────────────
BACKEND_URL=https://api.example.com

# ── Database (Supabase) ────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
# RLS বাইপাস করে ব্যাকএন্ড-only/audit টেবিলে (যেমন evolution_logs) লেখার জন্য প্রয়োজন।
# না দিলে SUPABASE_KEY-তেই ফলব্যাক করবে।
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL_POOLER=

# ── Redis (Upstash) ────────────────────────────────────────────────────
REDIS_URL=
# Required by docker-compose.production.yml to enable Redis auth (--requirepass).
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── LLM API Keys ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
HF_API_KEY=
FIRECRAWL_API_KEY=

# ── LLM Rate Limits ────────────────────────────────────────────────────
GEMINI_RPM_LIMIT=9
GROQ_RPM_LIMIT=28
OPENROUTER_RPM_LIMIT=19

# ── Scraper Service ────────────────────────────────────────────────────
SCRAPER_MAX_CONCURRENCY=3
SCRAPER_TIMEOUT_SECONDS=45

# ── IDE Trio Pipeline (Gemini → Kilo → Cline) ─────────────────────────
# Stage 1 (Writer) needs GEMINI_API_KEY above.
# Stage 2 (Reviewer) uses the installed Kilo Code extension + backend GuardianAgent.
# Stage 3 (Checker) uses the installed Cline — optional API key enables direct CLI mode.
CLINE_API_KEY=
# Optional: Continue.dev API key used if present
CONTINUE_API_KEY=
# VS Code extension ID hints used by the Trio detector
TRIO_KILO_EXTENSION_ID=kilocode.kilo-code
TRIO_CLINE_EXTENSION_ID=saoudrizwan.claude-dev
TRIO_GEMINI_EXTENSION_ID=gemini.gemini-vscode


# ── Infisical (Secret Vault) ──────────────────────────────────────────
INFISICAL_TOKEN=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=

# ── Observability ──────────────────────────────────────────────────────
SENTRY_DSN=

# ── OTP / Security ─────────────────────────────────────────────────────
ENFORCE_ANTI_HACKING=false
OTP_COOLDOWN_SECONDS=60
DISCORD_OTP_WEBHOOK_URL=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
CI_WEBHOOK_SECRET=


# ── Feature Toggles ────────────────────────────────────────────────────
ENABLE_TIER8=false
ENABLE_EVOLUTION=false
ENABLE_DAILY_LEARNER=false
ENABLE_AUTO_HEALER=true
AUTO_REMEDIATION_DRY_RUN=true
SELF_HEALING_ENABLED=true
COST_GUARD_ENABLED=true

# ── SupremeAI 2.0 Infrastructure Agents (all default-OFF — opt-in) ────
# Neural Memory RAG: inject past experiences into task prompts (zero-cost
# sentence-transformers). default-OFF যাতে deploy হওয়ার সাথে সাথে vector_db
# query না যায় (free-tier latency সচেতনতা)।
ENABLE_MEMORY_AUGMENT=false
# Autonomous resource scaling (CPU/mem/response-time thresholds, 5-min cycle)
ENABLE_AUTOSCALING_AGENT=false
# Continuous performance optimization with auto-apply (15-min cycle)
ENABLE_PERFORMANCE_TUNING_AGENT=false
# Strategic cost tracking + opportunity identification (1-hour cycle)
ENABLE_COST_OPTIMIZATION_AGENT=false
# Periodic incremental backups + integrity verification (6-hour cycle)
ENABLE_DISASTER_RECOVERY_AGENT=false
# Disaster Recovery component paths (comma-separated, overrides defaults)
# DR_DB_PATHS=/data/db.sqlite3
# DR_CONFIG_PATHS=/config/,./config/
# DR_USER_DATA_PATHS=/data/users/,/storage/uploads/
# DR_SKILLS_PATHS=/skills/,/backend/skills/
# DR_MODELS_PATHS=/models/,/backend/models/
# DR_LOGS_PATHS=/logs/,/var/log/app/

# ── Performance ────────────────────────────────────────────────────────
UVICORN_WORKERS=1
MAINTENANCE_INTERVAL=120


# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND (React/Vite) — Build-time Environment Variables
# These are prefixed with VITE_ and injected at build time by Vite.
# They are NOT used by the Python backend.
# ══════════════════════════════════════════════════════════════════════════════

# Backend API URLs (used by frontend apiClient.ts)
VITE_API_URL=https://supremeai-backend-docker.onrender.com
VITE_ADMIN_BACKEND=https://supremeai-backend-docker.onrender.com
# Admin panel-এর frontend URL (CommandCenter/CrownJewelBrowser-এর ডিফল্ট browser URL হিসেবে ব্যবহৃত)
VITE_ADMIN_FRONTEND_URL=
VITE_USER_BACKEND=https://supremeai-backend-docker.onrender.com

# Portal type: "user" for Studio client, "admin" for Admin dashboard
VITE_PORTAL_TYPE=user

# WebSocket URL (optional override; auto-derived from API_URL if not set)
VITE_WS_BASE_URL=

# API Client Configuration
VITE_API_CONCURRENCY=3          # Max parallel API requests (default: 3)
VITE_API_TIMEOUT_MS=60000       # Request timeout in milliseconds (default: 60s)

# ══════════════════════════════════════════════════════════════════════════════
# VS CODE EXTENSION — Runtime Configuration
# These are read by the VS Code extension's package.json configuration schema.
# ══════════════════════════════════════════════════════════════════════════════

# Extension backend URL (default: same as VITE_API_URL)
SUPREMEAI_BACKEND_URL=https://supremeai-backend-docker.onrender.com

# User API key for authentication (stored securely by VS Code)
SUPREMEAI_AI_API_KEY=

# Extension feature flags
SUPREMEAI_CODEGEEX4_ENABLED=true
SUPREMEAI_ENABLE_REAL_TIME_LEARNING=true
SUPREMEAI_ENABLE_CODE_FLOW=true

# Missing Keys for CI
ALLOWED_TAKEOVER_TOKENS=""
ALLOWED_ORIGINS=""
AIDER_API_KEY=""
AGENT_ADMIN_PERMISSIONS_REQUIRED="True"
ADMIN_URL=""
ADMIN_TELEGRAM_CHAT_ID=""
ADMIN_RULES_DB_PATH=""
ADMIN_EMAILS=""
ADMIN_BACKEND_URL=""
ADMIN_AUTHORIZED=""

# ══════════════════════════════════════════════════════════════════════════════
# ## Required in production (Render) — added by Master Audit 2026-09-02
# These vars HARD-CRASH boot when missing (pydantic fail-fast exit 1 / import
# errors) — they caused the supremeai-primary-node / scraper-node / worker-node
# crash-loops. Placeholders ONLY — set real values in the Render dashboard or
# Infisical vault. Never commit real values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Secrets that crash core boot when missing ──────────────────────────
# ENCRYPTION_KEY: Fernet key, exactly 44 chars, url-safe base64. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# SUPREMEAI_JWT_SECRET: >= 64 chars. Generate:
#   python -c "import secrets; print(secrets.token_hex(64))"
SUPREMEAI_JWT_SECRET=
# SUPREMEAI_ADMIN_PASSWORD_HASH: bcrypt hash ($2b$...). Generate:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt()).decode())"
SUPREMEAI_ADMIN_PASSWORD_HASH=

# ── Supabase (Postgres + REST) — missing DB config crashes boot paths ──
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Redis (Upstash) — missing redis_url raises at task-queue import ────
# Use the rediss:// (TLS) connection string for Upstash.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Runtime / deployment mode ───────────────────────────────────────────
# CORS_ORIGINS: comma-separated; must contain https:// origins in production
# (the config validator rejects non-TLS / wildcard origins).
CORS_ORIGINS=https://supremeai-studio-client.onrender.com
ENV=production
# Which node this deployment is: core | worker | scraper
SUPREMEAI_SERVICE_ROLE=core
# Free-tier resource guards (512MB / shared CPU):
LOW_MEMORY_MODE=true
WEB_CONCURRENCY=1

# ── Optional LLM / tooling keys (degrade gracefully if absent) ──────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
FIRECRAWL_API_KEY=

# ── Canonical Testing & Sandbox Guards ────────────────────────────────────
ALLOW_TEST_ORIGIN_BYPASS=false
ALLOW_TEST_AUTH_BYPASS=false
ALLOW_SANDBOX_FALLBACK=false
ALLOW_LOCAL_SANDBOX_FALLBACK=false

# ── P0 Safety: DB-degradation escape hatch (Task 9-c) ────────────────────
# SUPABASE_ALLOW_DB_DEGRADATION: the ONE canonical opt-in flag that lets the
# backend boot and run WITHOUT a durable database in production. When false
# (default), production REFUSES every ephemeral SQLite fallback: subsystems
# (checkpoints, memory, audit log, pubsub/firestore queues, error patterns,
# uptime history, pending tasks, feedback/site-action/marketplace persistence,
# admin god rules, ecosystem store, experience/semantic cache, skill registry)
# either disable loudly (CRITICAL log, feature off, empty/503-style responses)
# or degrade to a bounded in-process buffer — data is NOT durable and is lost
# on restart. Set to true ONLY on free-tier/ephemeral deployments that accept
# persistence-less operation (same contract as database/session.py degraded
# REST-only boot). Dev/test environments ignore this flag.
SUPABASE_ALLOW_DB_DEGRADATION=false

# ── P0 Safety: dynamic skill dependency installs (Task 9-c2) ─────────────
# SUPREMEAI_SKILL_DEPS_ENABLED: runtime `pip install` by the SkillInstaller is
# disabled in production unless this is explicitly "true". Even when enabled,
# only ALLOWED_SKILL_DEPENDENCIES (skills/installer.py: httpx, beautifulsoup4,
# bs4, pandas) may be installed — anything else is rejected with SecurityError.
# Keep "false" unless you fully trust every skill source that can reach the
# installer; dev/test environments are not affected.
SUPREMEAI_SKILL_DEPS_ENABLED=false

