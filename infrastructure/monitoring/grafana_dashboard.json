{
  "dashboard": {
    "title": "SupremeAI 2.0 Comprehensive Metrics",
    "description": "Real-time monitoring dashboard for SupremeAI 2.0 platform",
    "panels": [
      {
        "type": "row",
        "title": "System Health Overview"
      },
      {
        "type": "graph",
        "title": "API Request Volume",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (handler)",
            "legendFormat": "{{handler}}"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "API Response Times (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
            "legendFormat": "{{handler}}"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Error Rates",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "yAxes": [
          {
            "label": "Percentage"
          }
        ]
      },
      {
        "type": "row",
        "title": "Database & Cache Performance"
      },
      {
        "type": "graph",
        "title": "Database Query Performance",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le, operation))",
            "legendFormat": "{{operation}}"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Cache Hit Rates",
        "targets": [
          {
            "expr": "cache_hits_total / (cache_hits_total + cache_misses_total) * 100",
            "legendFormat": "Cache Hit Rate %"
          }
        ],
        "yAxes": [
          {
            "label": "Percentage"
          }
        ]
      },
      {
        "type": "row",
        "title": "AI Model & Resource Utilization"
      },
      {
        "type": "graph",
        "title": "AI Model API Spend",
        "targets": [
          {
            "expr": "sum(increase(ai_model_cost_usd_total[1h]))",
            "legendFormat": "Hourly Cost"
          }
        ],
        "yAxes": [
          {
            "label": "USD"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Model Distribution Usage",
        "targets": [
          {
            "expr": "sum(rate(ai_model_requests_total[5m])) by (model)",
            "legendFormat": "{{model}}"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "System Resource Utilization",
        "targets": [
          {
            "expr": "process_cpu_percent",
            "legendFormat": "CPU %"
          },
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024",
            "legendFormat": "Memory MB"
          }
        ],
        "yAxes": [
          {
            "label": "Utilization"
          }
        ]
      },
      {
        "type": "row",
        "title": "Security & Rate Limiting"
      },
      {
        "type": "graph",
        "title": "Rate Limiting Events",
        "targets": [
          {
            "expr": "sum(rate(rate_limit_exceeded_total[5m])) by (limit_type)",
            "legendFormat": "{{limit_type}}"
          }
        ],
        "yAxes": [
          {
            "label": "Events/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Security Events",
        "targets": [
          {
            "expr": "sum(rate(security_events_total[5m])) by (event_type)",
            "legendFormat": "{{event_type}}"
          }
        ],
        "yAxes": [
          {
            "label": "Events/sec"
          }
        ]
      }
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "7d",
      "30d"
    ],
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  }
}
