# SupremeAI 2.0 — Environment Variables Template
# Copy this file to .env and fill in your values.
# For production, use the Render dashboard or Infisical vault instead.
# Canonical contract definitions: specs/001-dynamic-production-configuration/contracts/config-contract.md


# ── Core ──────────────────────────────────────────────────────────────
ENV=local
PORT=8080
HOST=0.0.0.0
SERVICE_ROLE=user  # "user" or "admin"

# ── CORS Origins (comma-separated or JSON array) ───────────────────────
# Production: set these to your actual deployment URLs. Never use "*" in production.
CORS_ORIGINS=["https://<frontend-url>","https://<frontend-url-2>","https://tiny-stroopwafel-2d981c.netlify.app","https://supremeai-lac.vercel.app","https://supremeai-a.web.app","https://supremeai-admin.web.app"]
# NOTE: USER_CORS_ORIGINS takes precedence over CORS_ORIGINS when set. The Firebase
# user app (supremeai-a.web.app) MUST be listed here or its login/API calls fail preflight.
USER_CORS_ORIGINS=["https://supremeai-a.web.app","https://supremeai-lac.vercel.app","https://supremeai-studio.vercel.app","https://<frontend-url>","https://<frontend-url-2>","https://tiny-stroopwafel-2d981c.netlify.app"]
ADMIN_CORS_ORIGINS=["https://supremeai-admin.web.app"]

# ── Allowed Hosts (comma-separated) ────────────────────────────────────
ALLOWED_HOSTS=<your-backend-host>,<your-secondary-backend-host>

# ── Secrets (REQUIRED in production) ───────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SUPREMEAI_JWT_SECRET=
# DEPRECATED alias for SUPREMEAI_JWT_SECRET (Issue #567) — set the canonical
# name above instead; the alias is accepted with a deprecation warning only.
JWT_SECRET=
SUPREMEAI_ADMIN_PASSWORD_HASH=
SUPREMEAI_ENCRYPTION_KEY=
SUPREMEAI_API_TOKEN=
SUPREMEAI_DOCS_USERNAME=admin
SUPREMEAI_DOCS_PASSWORD=

# ── Backend Configuration & Locations ──────────────────────────────────
# Required in production: canonical backend location
BACKEND_URL=https://api.example.com
SUPREMEAI_USER_BACKEND_URL=
SUPREMEAI_ADMIN_BACKEND_URL=

# ── Optional Services (graceful degradation when unset) ────────────────
# Scraper microservice endpoint (optional; unconfigured = not_configured)
SCRAPER_URL=
# Local offline LLM fallback endpoint (optional; user-local, never required)
OLLAMA_URL=

# ── Database (Supabase) ────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
# RLS বাইপাস করে ব্যাকএন্ড-only/audit টেবিলে (যেমন evolution_logs) লেখার জন্য প্রয়োজন।
# না দিলে SUPABASE_KEY-তেই ফলব্যাক করবে।
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL_POOLER=

# ── Redis (Upstash) ────────────────────────────────────────────────────
REDIS_URL=
# Required by docker-compose.production.yml to enable Redis auth (--requirepass).
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── LLM API Keys ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
HF_API_KEY=
FIRECRAWL_API_KEY=

# ── LLM Rate Limits ────────────────────────────────────────────────────
