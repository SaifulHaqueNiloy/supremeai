{
  "mcpServers": {
    "github.com/launchdarkly/mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "@launchdarkly/mcp-server",
        "--",
        "mcp",
        "start",
        "--api-key",
        "YOUR_LAUNCHDARKLY_API_KEY_HERE"
      ]
    }
  }
}
