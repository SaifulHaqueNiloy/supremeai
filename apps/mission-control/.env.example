# SupremeAI Mission Control — environment template
# Copy to .env and adjust before running in any environment.
#
# FE-09 (issue #502): the app previously shipped with no .env.example, so the
# first production boot crashed on PrismaClient initialization
# (error: Environment variable not found: DATABASE_URL).

# Prisma datasource (provider = "sqlite" in prisma/schema.prisma)
DATABASE_URL="file:./db/mission-control.db"

# SupremeAI MCP Tower control-plane endpoint (used by src/lib/tower-client.ts).
# When unset the client falls back to a local default — set it explicitly in prod.
# TOWER_URL="https://<render-mcp-url>"

# Shared admin key expected by the MCP tower for tool invocation.
# TOWER_ADMIN_KEY=""

# Optional: git auto-sync credentials used by /api/git/sync
# GITHUB_TOKEN=""
