{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "API_URL",
    "VITE_PORTAL_TYPE",
    "VITE_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "dist-admin/**",
        "dist-user/**",
        "build/**",
        "out/**"
      ]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@supremeai/design-tokens#build": {
      "outputs": ["outputs/**"]
    },
    "@supremeai/shared-services#build": {
      "outputs": ["dist/**", "types/**"],
      "dependsOn": ["@supremeai/shared-types#build"]
    },
    "@supremeai/shared-types#build": {
      "outputs": ["dist/**"]
    },
    "@supremeai/core-infrastructure#build": {
      "outputs": ["dist/**"]
    },
    "supremeai-vscode#build": {
      "dependsOn": ["@supremeai/shared-services#build", "@supremeai/design-tokens#build"],
      "outputs": ["out/**"]
    },
    "frontend#build": {
      "dependsOn": ["@supremeai/shared-services#build", "@supremeai/design-tokens#build"],
      "outputs": ["dist/**", "dist-admin/**", "dist-user/**"]
    },
    "deploy:studio": {
      "dependsOn": ["frontend#build"],
      "cache": false,
      "outputs": []
    },
    "deploy:admin": {
      "dependsOn": ["frontend#build"],
      "cache": false,
      "outputs": []
    }
  }
}