import os
base = r'c:\Users\n\supremeai\supremeai_2.0'
routes_dir = os.path.join(base, 'backend', 'api', 'routes')

# Files to check for admin-prefixed routes
files = ['simulator.py', 'agents.py', 'sandbox_api.py', 'repos.py', 
         'tools_registry.py', 'swarm.py', 'task.py', 'agent_workspace.py',
         'admin_librarian.py', 'approval_manager.py', 'memory.py', 
         'onboarding.py', 'preferences.py', 'usage_metrics.py', 'syncguard.py',
         'codeflow.py', 'evolution.py', 'github.py', 'email.py', 'feedback.py',
         'health.py', 'markdown.py', 'marketplace_endpoints.py', 'mobile_bff.py',
         'pr_review_api.py', 'sso.py', 'dock_actions.py', 'cdc_webhooks.py',
         'ci_webhooks.py', 'browser_tools.py', 'tools_ops.py']

for fname in sorted(files):
    path = os.path.join(routes_dir, fname)
    if not os.path.exists(path):
        continue
    with open(path, 'r', encoding='utf-8') as f:
        content = f.read()
    lines = content.split('\n')
    
    # Find admin-prefixed route decorators
    admin_routes = []
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith(('@router.post(', '@router.put(', '@router.delete(', '@router.patch(')):
            if 'admin' in stripped.lower():
                func = ''
                for j in range(i+1, min(i+5, len(lines))):
                    l = lines[j].strip()
                    if l and not l.startswith('#') and not l.startswith('@') and not l.startswith('"""') and not l.startswith("'''"):
                        func = l[:80]
                        break
                admin_routes.append((stripped, func))
    
    if admin_routes:
        print(f'\n=== {fname} ({len(admin_routes)} admin route(s)) ===')
        for route, func in admin_routes:
            print(f'  {route[:80]}')
            if func:
                print(f'    def {func}')