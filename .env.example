MISTRAL_API_KEY=
# ── P0 Safety: DB-degradation escape hatch (Task 9-c) ────────────────────
# SUPABASE_ALLOW_DB_DEGRADATION: the ONE canonical opt-in flag that lets the
# backend boot and run WITHOUT a durable database in production. When false
# (default), production REFUSES every ephemeral SQLite fallback: subsystems
# (checkpoints, memory, audit log, pubsub/firestore queues, error patterns,
# uptime history, pending tasks, feedback/site-action/marketplace persistence,
# admin god rules, ecosystem store, experience/semantic cache, skill registry)
# either disable loudly (CRITICAL log, feature off, empty/503-style responses)
# or degrade to a bounded in-process buffer — data is NOT durable and is lost
# on restart. Set to true ONLY on free-tier/ephemeral deployments that accept
# persistence-less operation (same contract as database/session.py degraded
# REST-only boot). Dev/test environments ignore this flag.
SUPABASE_ALLOW_DB_DEGRADATION=false
# ── P0 Safety: dynamic skill dependency installs (Task 9-c2) ─────────────
# SUPREMEAI_SKILL_DEPS_ENABLED: runtime `pip install` by the SkillInstaller is
# disabled in production unless this is explicitly "true". Even when enabled,
# only ALLOWED_SKILL_DEPENDENCIES (skills/installer.py: httpx, beautifulsoup4,
# bs4, pandas) may be installed — anything else is rejected with SecurityError.
# Keep "false" unless you fully trust every skill source that can reach the
# installer; dev/test environments are not affected.
SUPREMEAI_SKILL_DEPS_ENABLED=false
# Secret for verifying GitHub hook signatures (X-Hub-Signature-256) on
# /api/v1/pr-review/webhook. MUST be set — endpoint fails closed without it.
# Generate with: openssl rand -hex 32  (also set the same value as the
# webhook secret in the GitHub repository settings)
GITHUB_WEBHOOK_SECRET=
# M05 P-A (issue #453): শূন্য-খরচ learning loop (aggregate→propose, কোনো LLM কল নেই,
# proposal কখনো auto-apply হয় না) — ডিফল্ট এখন true; বন্ধ করতে চাইলে false করুন।
ENABLE_LEARNING_LOOP=true
# M05 P-A দ্বিতীয় অর্ধ: bounded adaptive exploration — চেইন-লেজে ১ candidate,
# কেবল normal-tier evidence (≥50 observation)। kill-switch: false = আজকের আচরণ।
ENABLE_ADAPTIVE_ROUTING=true
# --- M07 P-E/P-F: Context Engine (single estimator + config + kill-switch) ---
# কিল-সুইচ: off = raw-prompt passthrough (budget assembly বন্ধ); on/অনুপস্থিত = চালু;
# অজানা মান fail-closed (বন্ধ)।
SUPREMEAI_CONTEXT_ENGINE=on
# ডিফল্ট input budget tokens (provider-অজানা কলে; provider জানা থাকলে vendor-সত্য রেজিস্ট্রি)
CONTEXT_ENGINE_DEFAULT_INPUT_BUDGET=3000
# Per-section budget caps (0 < cap ≤ 1; ডিফল্ট = ইঞ্জিনের লিগ্যাসি মান)
CONTEXT_ENGINE_SYSTEM_CAP=0.25
CONTEXT_ENGINE_MEMORY_CAP=0.40
CONTEXT_ENGINE_KNOWLEDGE_CAP=0.60
CONTEXT_ENGINE_HISTORY_CAP=0.75
# Secret token Telegram sends back in the X-Telegram-Bot-Api-Secret-Token header
# (setWebhook secret_token) — verifies /telegram/webhook, /telegram callback and
# /send-alert callers. MUST be set — these endpoints fail closed without it.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# ── Wave 4 feature flags (প্রতিটি ডিফল্ট-অফ/ডিফল্ট-অপরিবর্তিত — আচরণ-নিরপেক্ষ) ──
# M09 P-A: governed agent tool execution loop (default: off)
SUPREMEAI_AGENT_TOOLS=false
# M06 P-A: universal canonical-run observation on dispatch paths (default: off)
SUPREMEAI_RUN_FABRIC_UNIVERSAL=false
# M01 P-A: memory consolidation kill-switch (default: on; false = legacy blind INSERT)
SUPREMEAI_MEMORY_DEDUP=true
# M01 P-A: consolidation cosine threshold (0,1]; default 0.92
SUPREMEAI_MEMORY_DEDUP_THRESHOLD=0.92
# M19 P-D: Bengali chars-per-token ratio for token estimation; default 2.0
BENGALI_CHARS_PER_TOKEN=2.0
# Issue #906: docker-compose fail-fast keys
POSTGRES_USER=supremeai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=supremeai_dev
# ── FIX(F-7): production/deploy-relevant vars previously missing from this template ──
# Firebase service account (MCP tower on Render, render.yaml) — JSON string or
# base64 of the service-account key file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# MCP control-plane auth keys (infrastructure/mcp-control-plane).
MCP_API_KEY=
MCP_ADMIN_KEY=
# Edge/worker ↔ tower auth tokens.
WORKER_AUTH_TOKEN=
TOWER_AUTH_TOKEN=
# Supabase writer DSN used by the ci-deploy-production migration gate.
SUPABASE_DATABASE_URL_WRITER=
# Frontend → MCP control-plane URL (baked into Vite bundle at build time).
VITE_MCP_CONTROL_PLANE_URL=

