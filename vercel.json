{
  "version": 2,
  "buildCommand": "pnpm --filter supremeai-studio-client build:user",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./apps/studio-client",
  "outputDirectory": "apps/studio-client/dist-user",
  "framework": "vite",
  "env": {
    "VITE_PORTAL_TYPE": "user"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://supremeai-backend-08zd.onrender.com/api/$1"
    },
    {
      "source": "/admin-api/(.*)",
      "destination": "https://supremeai-backend-08zd.onrender.com/admin-api/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://supremeai-backend-08zd.onrender.com/ws/$1"
    },
    {
      "source": "/telemetry/(.*)",
      "destination": "https://supremeai-backend-08zd.onrender.com/telemetry/$1"
    }
  ]
}
