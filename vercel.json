{
  "version": 2,
  "buildCommand": "pnpm --filter supremeai-studio-client build:user",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./apps/studio-client",
  "outputDirectory": "apps/studio-client/dist-user",
  "framework": "vite",
  "env": {
    "VITE_PORTAL_TYPE": "user"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://supremeai-backend-65hl.onrender.com/api/$1"
    },
    {
      "source": "/admin-api/(.*)",
      "destination": "https://supremeai-backend-65hl.onrender.com/admin-api/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://supremeai-backend-65hl.onrender.com/ws/$1"
    },
    {
      "source": "/telemetry/(.*)",
      "destination": "https://supremeai-backend-65hl.onrender.com/telemetry/$1"
    },
    {
      "source": "/logs/stream",
      "destination": "https://supremeai-backend-65hl.onrender.com/logs/stream"
    },
    {
      "source": "/default/stream",
      "destination": "https://supremeai-backend-65hl.onrender.com/default/stream"
    },
    {
      "source": "/:user_id/stream",
      "destination": "https://supremeai-backend-65hl.onrender.com/:user_id/stream"
    }
  ]
}
