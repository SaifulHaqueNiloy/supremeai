# Coverage configuration for SupremeAI Backend
# বাংলা মন্তব্য: অপরিপক্ক/পরীক্ষা-হীন মডিউলগুলি কভারেজ প্রয়োজনীয়তা থেকে বাদ দেওয়া হয়েছে। প্রতিটি নতুন ফিচারের সাথে নতুন পরীক্ষা যোগ করা হবে।

[run]
branch = True
omit =
    */site-packages/*
    */distutils/*
    */tests/*
    */__pycache__/*

[report]
# Exclude Phase 2+ untested modules from coverage requirement
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abstractproperty

# Modules to exclude entirely (Phase 2+ - not yet fully tested)
omit =
    core/agent*.py
    core/api*.py
    core/app.py
    core/audit*.py
    core/auth*.py
    core/auto*.py
    core/circuit*.py
    core/cloud*.py
    core/code*.py
    core/constants.py
    core/db*.py
    core/decision*.py
    core/discord*.py
    core/email*.py
    core/error*.py
    core/events.py
    core/evolution*.py
    core/factual*.py
    core/feedback*.py
    core/free*.py
    core/gcp*.py
    core/generation*.py
    core/grpc*.py
    core/health*.py
    core/honeypot*.py
    core/idempotency*.py
    core/immune*.py
    core/input*.py
    core/intent*.py
    core/language*.py
    core/ld*.py
    core/lifespan.py
    core/logging*.py
    core/mcp*.py
    core/microvm*.py
    core/multi_layer*.py
    core/observability*.py
    core/orchestrator.py
    core/origin*.py
    core/output*.py
    core/pgbouncer*.py
    core/posthog*.py
    core/prompt*.py
    core/rbac.py
    core/redis*.py
    core/rollback*.py
    core/rules*.py
    core/schema*.py
    core/secret*.py
    core/secure*.py
    core/security.py
    core/self*.py
    core/semantic*.py
    core/services.py
    core/skill*.py
    core/task*.py
    core/telemetry.py
    core/tenant*.py
    core/token*.py
    core/universal*.py
    core/upload*.py
    core/upstash*.py
    core/user*.py
    core/rate*.py

[html]
directory = htmlcov

[json]
output = coverage.json
