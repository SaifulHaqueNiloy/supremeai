{
    "schema_version": "1.0",
    "rules": [
        {
            "id": "CORE-001",
            "name": "Fail-Fast, Fail-Loud",
            "severity": "CRITICAL",
            "domain_scope": "GLOBAL",
            "section": "Core Architecture & Mindset",
            "description": "System must crash immediately on missing configuration or secrets.",
            "automatable": true,
            "check": {
                "type": "startup_probe",
                "logic": "Verify that critical config loaders raise exceptions on missing values."
            }
        },
        {
            "id": "CORE-009",
            "name": "Assume Network will Fail",
            "severity": "WARNING",
            "domain_scope": "GLOBAL",
            "section": "Core Architecture & Mindset",
            "description": "All network calls must have explicit timeout and retry logic.",
            "automatable": true,
            "check": {
                "type": "static_analysis",
                "pattern": "Look for `requests.get`, `httpx.AsyncClient` calls without a `timeout=` parameter."
            }
        },
        {
            "id": "CLEAN-018",
            "name": "Type Hinting is Mandatory",
            "severity": "WARNING",
            "domain_scope": "GLOBAL",
            "section": "Refactoring & Clean Code",
            "description": "No `Any` type should be used. All functions and variables must have type hints.",
            "automatable": true,
            "check": {
                "type": "linter",
                "tool": "mypy",
                "config": "--disallow-untyped-defs --disallow-any-unimported"
            }
        },
        {
            "id": "CLEAN-013",
            "name": "No Commented-out Code",
            "severity": "INFO",
            "domain_scope": "GLOBAL",
            "section": "Refactoring & Clean Code",
            "description": "Codebase should not contain commented-out blocks of code. Use version control instead.",
            "automatable": true,
            "check": {
                "type": "regex_check",
                "file_pattern": "*.py",
                "regex": "^\\s*#\\s*(def|if|for|while|class)",
                "match_should_fail": true
            }
        },
        {
            "id": "CLEAN-019",
            "name": "Avoid Deep Nesting",
            "severity": "WARNING",
            "domain_scope": "GLOBAL",
            "section": "Refactoring & Clean Code",
            "description": "Nesting of if/else/for loops should not exceed 3 levels.",
            "automatable": true,
            "check": {
                "type": "linter",
                "tool": "ruff",
                "rule": "C901"
            }
        },
        {
            "id": "DOC-101",
            "name": "README Must Be Present",
            "severity": "INFO",
            "domain_scope": "GLOBAL",
            "section": "Documentation & Knowledge Management",
            "description": "Every module or microservice root must contain a README.md file.",
            "automatable": true,
            "check": {
                "type": "file_system_check",
                "path": "**/README.md",
                "condition": "must_exist_in_module_root"
            }
        },
        {
            "id": "DOC-103",
            "name": "Docstrings Are Mandatory",
            "severity": "INFO",
            "domain_scope": "GLOBAL",
            "section": "Documentation & Knowledge Management",
            "description": "Every public function, class, and module must have a docstring.",
            "automatable": true,
            "check": {
                "type": "linter",
                "tool": "ruff",
                "rule": "D100, D101, D102, D103"
            }
        },
        {
            "id": "GIT-022",
            "name": "Conventional Commits",
            "severity": "INFO",
            "domain_scope": "GLOBAL",
            "section": "Git & Version Control",
            "description": "Commit messages must follow the Conventional Commits specification.",
            "automatable": true,
            "check": {
                "type": "ci_command",
                "command": "npx commitlint --from HEAD~1 --to HEAD --verbose"
            }
        },
        {
            "id": "GIT-027",
            "name": "Don't Commit Secrets",
            "severity": "CRITICAL",
            "domain_scope": "GLOBAL",
            "section": "Git & Version Control",
            "description": "No secrets (API keys, passwords) should be committed to the repository.",
            "automatable": true,
            "check": {
                "type": "ci_command",
                "command": "gitleaks detect --verbose"
            }
        },
        {
            "id": "SEC-046",
            "name": "Strict CORS Policy",
            "severity": "CRITICAL",
            "domain_scope": "GLOBAL",
            "section": "Security & Authentication",
            "description": "CORS origin policy should not be a wildcard ('*') in production.",
            "automatable": true,
            "check": {
                "type": "config_check",
                "logic": "Scan FastAPI middleware configuration for `allow_origins=['*']`."
            }
        },
        {
            "id": "SEC-047",
            "name": "Avoid SQL Injection",
            "severity": "CRITICAL",
            "domain_scope": "GLOBAL",
            "section": "Security & Authentication",
            "description": "Use an ORM and avoid raw SQL queries with string formatting.",
            "automatable": true,
            "check": {
                "type": "linter",
                "tool": "bandit",
                "rule": "B608"
            }
        },
        {
            "id": "DEP-106",
            "name": "Pin Dependencies",
            "severity": "WARNING",
            "domain_scope": "GLOBAL",
            "section": "Dependency Management",
            "description": "All dependencies in requirements files must be pinned with `==` or `~=`.",
            "automatable": true,
            "check": {
                "type": "regex_check",
                "file_pattern": "*requirements*.txt",
                "regex": "^[a-zA-Z0-9\\-_]+\\s*(>|>=|<|<=|!=|===|\\s*$)",
                "match_should_fail": true
            }
        },
        {
            "id": "DEP-107",
            "name": "No Vulnerable Packages",
            "severity": "CRITICAL",
            "domain_scope": "GLOBAL",
            "section": "Dependency Management",
            "description": "The project must not have dependencies with known security vulnerabilities.",
            "automatable": true,
            "check": {
                "type": "ci_command",
                "command": "pip-audit"
            }
        },
        {
            "id": "TEST-063",
            "name": "Test Coverage Rule",
            "severity": "WARNING",
            "domain_scope": "GLOBAL",
            "section": "Testing & QA",
            "description": "Overall test coverage must not fall below a defined threshold (e.g., 80%).",
            "automatable": true,
            "check": {
                "type": "ci_command",
                "command": "coverage run -m pytest && coverage report --fail-under=80"
            }
        },
        {
            "id": "AGENT-201",
            "name": "Hallucination Check",
            "severity": "WARNING",
            "domain_scope": "AGENTIC",
            "section": "Agent Behavior",
            "description": "Agent must cite sources. If no source found, agent must decline to answer.",
            "automatable": true,
            "check": {
                "type": "runtime_llm_eval",
                "logic": "Verify response contains <source> tags or is marked as 'I don't know'."
            }
        },
        {
            "id": "AGENT-202",
            "name": "Cost-Per-Execution Limit",
            "severity": "CRITICAL",
            "domain_scope": "AGENTIC",
            "section": "Agent Behavior",
            "description": "Agents must not exceed a predefined token/cost budget per task.",
            "automatable": true,
            "check": {
                "type": "runtime_telemetry",
                "logic": "If tokens > 4096, abort and log cost spike."
            }
        },
        {
            "id": "AGENT-203",
            "name": "Tool Use Verification",
            "severity": "CRITICAL",
            "domain_scope": "AGENTIC",
            "section": "Agent Behavior",
            "description": "Agents must use tools exactly as defined in the schema.",
            "automatable": true,
            "check": {
                "type": "schema_validation",
                "logic": "Validate tool input parameters against JSON Schema before execution."
            }
        }
    ]
}