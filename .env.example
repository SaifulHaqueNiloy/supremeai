# === SupremeAI 2.0 Environment Variables ===
# এই ফাইলটি .env-এ কপি করে আপনার নিজের credentials দিন
# cp .env.example .env

# --- Core ---
PROJECT_NAME="SupremeAI 2.0"
API_V1_STR="/api/v1"
ENV=local
PORT=8000

# --- AI Provider Keys (প্রতিটি provider থেকে নিজের key নিন) ---
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
HF_API_KEY=hf_YOUR_TOKEN_HERE
GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
GROQ_API_KEY=gsk_YOUR_KEY_HERE
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE

# --- GitHub ---
GITHUB_TOKEN=github_pat_YOUR_PAT_HERE
GITHUB_API_TOKEN=github_pat_YOUR_PAT_HERE

# --- Supabase ---
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@host:5432/postgres
SUPABASE_DATABASE_URL_POOLER=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@host:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=sb_secret_YOUR_KEY_HERE
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# --- Security (অবশ্যই generate করুন!) ---
# python -c "import secrets; print(secrets.token_hex(64))"
SUPREMEAI_JWT_SECRET=GENERATE_A_RANDOM_256_BIT_SECRET
DOCS_PASSWORD=GENERATE_A_RANDOM_PASSWORD
# python -c "import pyotp; print(pyotp.random_base32())"
SUPREMEAI_ADMIN_TOTP_SECRET=GENERATE_VIA_PYOTP

# --- Encryption ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

# --- CI/CD ---
CI_WEBHOOK_SECRET=GENERATE_A_RANDOM_SECRET

# --- Monitoring (Optional) ---
SENTRY_DSN=
OLLAMA_URL=http://localhost:11434
