      "tool": {
        "driver": {
          "name": "supremeai-audit",
          "informationUri": "https://github.com/SaifulHaqueNiloy/supremeai",
          "rules": [
            {
              "id": "ISOLATED_MODULE",
              "shortDescription": {
                "text": "Module is never imported, referenced, configured, or dynamically loaded"
              }
            },
            {
              "id": "UNDERUTILIZED_CAPABILITY",
              "shortDescription": {
                "text": "Capability defined in a registry but never wired/invoked"
              }
            }
          ]
        }
      },
