{
  "mcpServers": {
    "supremeai-control-tower": {
      "command": "npx",
      "args": [
        "tsx",
        "src/index.ts"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    "supremeai-memory": {
      "command": "poetry",
      "args": [
        "-C",
        "backend",
        "run",
        "python",
        "memory/mcp_server.py"
      ],
      "env": {
        "MEMORY_MCP_TRANSPORT": "stdio"
      }
    }
  }
}
