# ==============================================================================
# SupremeAI — Grafana environment template (observability profile)
# ==============================================================================
# FIX(F-3): docker-compose.production.yml references `env_file: .env.grafana`
# for the grafana service, but neither the file nor a template existed → the
# observability profile aborted on a fresh host.
#
# Usage:
#   cp .env.grafana.example .env.grafana   (then fill in real values)
#
# SECURITY: never commit the real .env.grafana.
# ==============================================================================

# Admin credentials for the Grafana UI (provisioned at first boot).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=   # generate: python -c "import secrets; print(secrets.token_urlsafe(24))"

# Public URL Grafana uses for redirects/emails. Loopback default matches the
# compose port mapping (127.0.0.1:3300:3000); change for reverse-proxy setups.
GF_SERVER_ROOT_URL=http://localhost:3300

# Hardening: no self-signup on a production observability plane.
GF_USERS_ALLOW_SIGN_UP=false

# Optional: anonymous access off (default), explicit for clarity.
GF_AUTH_ANONYMOUS_ENABLED=false
