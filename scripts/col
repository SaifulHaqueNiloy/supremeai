#!/usr/bin/env python3
"""
SupremeAI — Google Colab Mergekit Pipeline
============================================

Merges specialized LoRA adapters (Bengali + Coder + Math-Logic) into a single
hybrid 8B model using Mergekit TIES methodology, then quantizes to GGUF Q4_K_M
for deployment on HuggingFace Spaces.

Usage (Google Colab):
    !pip install mergekit
    !python scripts/colab_merge_pipeline.py --upload

Bengali:
    গুগল কোলাব-এ মার্জকিট স্ক্রিপ্ট রান করার লুপ
    মডেল মার্জ করার পর সেটিকে HuggingFace হাব-এ আপলোড করার অটোমেটেড পুশ লজিক
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

# ── Constants ─────────────────────────────────────────────────────────────────
BASE_MODEL = "meta-llama/Meta-Llama-3-8B-Instruct"
HF_USERNAME = "supreme-ai"  # Change to your HF username
MODEL_NAME = "supreme-hybrid-8b"

# Adapter configuration (weights sum to 1.0)
ADAPTERS: list[dict[str, Any]] = [
    {
        "model": "supreme-ai/bengali-lora-adapter",
        "weight": 0.4,
        "description": "Bengali language LoRA adapter",
    },
    {
        "model": "supreme-ai/coder-lora-adapter",
        "weight": 0.4,
        "description": "Code generation LoRA adapter",
    },
    {
        "model": "supreme-ai/math-logic-adapter",
        "weight": 0.2,
        "description": "Math and logic reasoning LoRA adapter",
    },
]

# Mergekit YAML configuration template
MERGE_YAML_TEMPLATE = """\
# Auto-generated by SupremeAI Mergekit Pipeline
# Method: TIES (Trim, Elect Sign, and Merge)
# Base: {base_model}
# Adapters: {adapter_list}

slices:
  - sources:
      - model: {base_model}
        layer_range: [0, 32]
  - sources:
      - model: adapter_0
        layer_range: [0, 32]
      - model: adapter_1
        layer_range: [0, 32]
      - model: adapter_2
        layer_range: [0, 32]

merge_method: ties
base_model: {base_model}

parameters:
  normalize: true
  int8_mask: true

dtype: bfloat16

tokenizer:
  source: {base_model}
"""


def create_merge_config(output_dir: Path) -> Path:
    """Create the Mergekit YAML configuration file."""
    adapter_list = ", ".join(a["model"] for a in ADAPTERS)
    yaml_content = MERGE_YAML_TEMPLATE.format(
        base_model=BASE_MODEL,
        adapter_list=adapter_list,
    )

    config_path = output_dir / "merge_config.yaml"
    config_path.write_text(yaml_content, encoding="utf-8")
    print(f"  ✅ Created merge config: {config_path}")
    print(f"     Base: {BASE_MODEL}")
    for i, adapter in enumerate(ADAPTERS):
        print(f"     Adapter {i}: {adapter['model']} (weight: {adapter['weight']})")
    return config_path


def run_merge(config_path: Path, output_dir: Path, use_cuda: bool = True) -> bool:
    """
    Run the Mergekit merge operation.

    Requires: pip install mergekit
    """
    cmd = [
        sys.executable, "-m", "mergekit",
        "--merge-yaml", str(config_path),
        "--output-dir", str(output_dir),
    ]
    if use_cuda:
        cmd.append("--cuda")

    print(f"\n🚀 Running Mergekit merge...")
    print(f"    Command: {' '.join(cmd)}")
    print(f"    This may take 30-60 minutes on a T4 GPU\n")

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"❌ Merge failed: {result.stderr}")
        return False

    print(f"  ✅ Merge complete! Output: {output_dir}")
    return True


def quantize_to_gguf(input_dir: Path, output_path: Path) -> bool:
    """
    Quantize the merged model to GGUF Q4_K_M format.

    Requires: llama.cpp installed and compiled
    """
    convert_script = Path("llama.cpp/convert.py")
    if not convert_script.exists():
        print(f"  ⚠️  llama.cpp not found at {convert_script}")
        print("  Please clone: git clone https://github.com/ggerganov/llama.cpp.git")
        return False

    cmd = [
        sys.executable, str(convert_script),
        str(input_dir),
        "--outtype", "q4_k_m",
        "--outfile", str(output_path),
    ]

    print(f"\n🔧 Running GGUF quantization (Q4_K_M)...")
    print(f"    Command: {' '.join(cmd)}\n")

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"❌ Quantization failed: {result.stderr}")
        return False

    print(f"  ✅ Quantization complete! Output: {output_path}")
    return True


def upload_to_huggingface(model_dir: Path, repo_id: str, token: str | None = None) -> bool:
    """
    Upload the merged model to HuggingFace Hub.

    Args:
        model_dir: Path to the merged model directory
        repo_id: HuggingFace repo ID (e.g., 'supreme-ai/supreme-hybrid-8b')
        token: HuggingFace API token (defaults to HF_TOKEN env var)
    """
    hf_token = token or os.environ.get("HF_TOKEN")
    if not hf_token:
        print("❌ No HuggingFace token found. Set HF_TOKEN env var or pass --token")
        return False

    try:
        from huggingface_hub import HfApi
    except ImportError:
        print("❌ huggingface_hub not installed. Run: pip install huggingface_hub")
        return False

    api = HfApi()
    api.upload_folder(
        folder_path=str(model_dir),
        repo_id=repo_id,
        repo_type="model",
        token=hf_token,
    )
    print(f"  ✅ Uploaded to HuggingFace: https://huggingface.co/{repo_id}")
    return True


def create_hf_space_config(output_dir: Path) -> Path:
    """Create the HuggingFace Space configuration files."""
    space_dir = output_dir / "apps" / "hf-space"
    space_dir.mkdir(parents=True, exist_ok=True)

    # Dockerfile
    dockerfile = space_dir / "Dockerfile"
    dockerfile.write_text(f"""\
# SupremeAI HuggingFace Space — Hybrid 8B Model Server
# Uses llama-cpp-python for GGUF inference

FROM ghcr.io/huggingface/text-generation-inference:latest

# Copy the quantized model
COPY {MODEL_NAME}-q4.gguf /models/{MODEL_NAME}-q4.gguf

# Environment configuration
ENV MODEL_ID=/models/{MODEL_NAME}-q4.gguf
ENV MAX_INPUT_LENGTH=4096
ENV MAX_TOTAL_TOKENS=8192
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \\
    CMD curl -f http://localhost:80/health || exit 1

EXPOSE 80
""", encoding="utf-8")

    # README for the Space
    readme = space_dir / "README.md"
    readme.write_text(f"""\
---
title: SupremeAI Hybrid 8B
emoji: 🧠
colorFrom: blue
colorTo: purple
sdk: docker
app_port: 80
---

# SupremeAI Hybrid 8B

Merged model combining Bengali language, code generation, and math-logic
capabilities using Mergekit TIES methodology.

## API

Compatible with the SupremeAI LLMRouter provider schema:

```json
{{
  "model": "supreme-hybrid-8b",
  "messages": [{{"role": "user", "content": "Hello"}}],
  "max_tokens": 1024
}}
```

## Health Check

```bash
curl https://{{space-id}}.hf.space/health
```
""", encoding="utf-8")

    print(f"  ✅ Created HF Space config: {space_dir}")
    return space_dir


def main() -> int:
    """Main entry point for the Mergekit pipeline."""
    parser = argparse.ArgumentParser(
        description="SupremeAI Mergekit Pipeline — Merge LoRA adapters into hybrid 8B model",
    )
    parser.add_argument(
        "--output-dir",
        default="./merged_model",
        help="Output directory for the merged model",
    )
    parser.add_argument(
        "--skip-merge",
        action="store_true",
        help="Skip the merge step (use existing merged model)",
    )
    parser.add_argument(
        "--skip-quantize",
        action="store_true",
        help="Skip the quantization step",
    )
    parser.add_argument(
        "--upload",
        action="store_true",
        help="Upload to HuggingFace Hub after merge",
    )
    parser.add_argument(
        "--token",
        default=None,
        help="HuggingFace API token",
    )
    parser.add_argument(
        "--create-space",
        action="store_true",
        help="Create HuggingFace Space configuration files",
    )
    args = parser.parse_args()

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    print("=" * 60)
    print("  SupremeAI Mergekit Pipeline")
    print("=" * 60)
    print(f"  Base Model: {BASE_MODEL}")
    print(f"  Adapters: {len(ADAPTERS)}")
    for i, adapter in enumerate(ADAPTERS):
        print(f"    {i}. {adapter['model']} (weight: {adapter['weight']})")
    print(f"  Output: {output_dir}")
    print()

    # Step 1: Create merge config
    print("📝 Step 1: Creating merge configuration...")
    config_path = create_merge_config(output_dir)

    # Step 2: Run merge
    if not args.skip_merge:
        print("\n🔨 Step 2: Running model merge...")
        merged_dir = output_dir / "merged"
        if not run_merge(config_path, merged_dir):
            return 1
    else:
        merged_dir = output_dir / "merged"
        print("\n⏭️  Step 2: Skipping merge (using existing)")

    # Step 3: Quantize to GGUF
    quantized_path = output_dir / f"{MODEL_NAME}-q4.gguf"
    if not args.skip_quantize:
        print("\n🔧 Step 3: Quantizing to GGUF Q4_K_M...")
        if not quantize_to_gguf(merged_dir, quantized_path):
            print("  ⚠️  Quantization failed or llama.cpp not found. Skipping.")
    else:
        print("\n⏭️  Step 3: Skipping quantization")

    # Step 4: Upload to HuggingFace
    if args.upload:
        print("\n📤 Step 4: Uploading to HuggingFace Hub...")
        repo_id = f"{HF_USERNAME}/{MODEL_NAME}"
        if upload_to_huggingface(merged_dir, repo_id, args.token):
            print(f"  ✅ Model available at: https://huggingface.co/{repo_id}")

    # Step 5: Create HF Space config
    if args.create_space:
        print("\n🏗️  Step 5: Creating HuggingFace Space configuration...")
        create_hf_space_config(output_dir)

    print()
    print("✅ Pipeline complete!")
    print(f"   Merged model: {merged_dir}")
    if quantized_path.exists():
        size_mb = quantized_path.stat().st_size / (1024 * 1024)
        print(f"   Quantized: {quantized_path} ({size_mb:.1f} MB)")
    print()
    print("Next steps:")
    print("  1. Upload the merged model to HuggingFace Hub")
    print("  2. Deploy the HF Space using apps/hf-space/")
    print("  3. Add the HF Space as a provider in backend/core/llm_router.py")
    print("  4. Run: pytest tests/test_expert_router.py -k 'test_hf_space'")

    return 0


if __name__ == "__main__":
    sys.exit(main())
