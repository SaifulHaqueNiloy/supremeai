{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "API_URL",
    "VITE_API_URL",
    "VITE_API_BASE",
    "VITE_API_BASE_URL",
    "VITE_BACKEND_URL",
    "VITE_USER_BACKEND",
    "VITE_ADMIN_BACKEND",
    "VITE_SECONDARY_BACKEND",
    "VITE_PRIMARY_BACKEND",
    "VITE_SCRAPER_BACKEND",
    "VITE_SCRAPER_URL",
    "VITE_SCRAPER_SERVICE_URL",
    "VITE_WS_BASE_URL",
    "VITE_USE_RELATIVE_PATH",
    "VITE_CIRCUIT_FAILURE_THRESHOLD",
    "VITE_CIRCUIT_RECOVERY_MS",
    "VITE_MAX_RETRIES",
    "VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_FIREBASE_API_KEY",
    "VITE_FIREBASE_PROJECT_ID",
    "VITE_FIREBASE_AUTH_DOMAIN",
    "VITE_FIREBASE_STORAGE_BUCKET",
    "VITE_FIREBASE_MESSAGING_SENDER_ID",
    "VITE_FIREBASE_APP_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "out/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@supremeai/design-tokens#build": {
      "outputs": [
        "outputs/**"
      ]
    },
    "@supremeai/shared-services#build": {
      "outputs": [
        "dist/**",
        "types/**"
      ],
      "dependsOn": [
        "@supremeai/shared-types#build"
      ]
    },
    "@supremeai/shared-types#build": {
      "outputs": [
        "dist/**"
      ]
    },
    "@supremeai/core-infrastructure#build": {
      "outputs": [
        "dist/**"
      ]
    },
    "supremeai-vscode#build": {
      "dependsOn": [
        "@supremeai/shared-services#build",
        "@supremeai/design-tokens#build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "frontend#build": {
      "dependsOn": [
        "@supremeai/shared-services#build",
        "@supremeai/design-tokens#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@supremeai/ui-components#build": {
      "dependsOn": [
        "@supremeai/shared-types#build",
        "@supremeai/design-tokens#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "deploy:frontend": {
      "dependsOn": [
        "frontend#build"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
