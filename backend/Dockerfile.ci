FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libpq-dev build-essential git && rm -rf /var/lib/apt/lists/*

# ১. আগে Torch ইন্সটল করুন (এটি সেটআপটুলস ৮৩ টানবে)
RUN pip install --no-cache-dir torch

# ২. তারপর আমাদের প্রয়োজনীয় সেটআপটুলস ভার্সনটি এনফোর্স করুন
RUN pip install --no-cache-dir setuptools==68.0.0 wheel

# ৩. সবশেষে Whisper ইন্সটল করুন
RUN pip install --no-cache-dir openai-whisper==20240930 --no-build-isolation

RUN pip install --no-cache-dir poetry
RUN poetry config virtualenvs.create false
WORKDIR /app
RUN chown -R 1001:1001 /app
