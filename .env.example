# kill-switch false = আজকের আচরণ (কোনো scheduler-চালিত dream চক্র নেই)।
# ক্যাডেন্স: SYNAPTIC_DREAM_INTERVAL_SECONDS (ডিফল্ট ৮৬৪০০ সেকেন্ড = ২৪ ঘণ্টা)।
ENABLE_SYNAPTIC_DREAM=true
